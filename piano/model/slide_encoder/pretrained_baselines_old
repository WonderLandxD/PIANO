import torch
import torch.nn as nn
import timm
from transformers import AutoModel


class CHIEFModel(nn.Module):
    def __init__(self, mode):
        super().__init__()
        self.mode = mode
        if self.mode == 'patch':

            from .chief.ctran import ctranspath

            self.patch_model = ctranspath()
            self.patch_model.head = nn.Identity()  # ctranspath: patch images -> patch features
            td = torch.load('/mnt/sdb/ljw/piano_weights/CHIEF/CHIEF_CTransPath.pth')
            self.patch_model.load_state_dict(td['model'], strict=True)
        elif self.mode == 'slide':

            from .chief.CHIEF import CHIEF

            self.slide_model = CHIEF(size_arg='small', word_embedding_path=r'/mnt/sdb/ljw/piano_weights/CHIEF/Text_emdding.pth', dropout=True, n_classes=2)
            td = torch.load('/mnt/sdb/ljw/piano_weights/CHIEF/CHIEF_pretraining.pth')
            self.slide_model.load_state_dict(td, strict=True)
        else:
            raise ValueError(f"Invalid mode: {self.mode}")
    
    def forward(self, input):
        if self.mode == 'patch':
            image_tensor = input
            output = self.patch_model(image_tensor)
            return output
        elif self.mode == 'slide':
            patch_features = input['feats']
            anatomical=13
            result = self.slide_model(patch_features, anatomical)
            output = result['WSI_feature'] 
            return output
        else:
            raise ValueError(f"Invalid mode: {self.mode}")
        

class GigaPathModel(nn.Module):
    def __init__(self, mode):
        super().__init__()
        self.mode = mode
        if self.mode == 'patch':
            self.patch_model = timm.create_model('hf_hub:prov-gigapath/prov-gigapath', pretrained=True)
        elif self.mode == 'slide':

            from .gigapath.slide_encoder import create_model
            
            self.slide_model = create_model("/mnt/sdb/ljw/piano_weights/GigaPath/slide_encoder.pth", "gigapath_slide_enc12l768d", 1536)
        else:
            raise ValueError(f"Invalid mode: {self.mode}")
    
    def forward(self, input):
        if self.mode == 'patch':
            image_tensor = input['feats']
            output = self.patch_model(image_tensor)
            return output
        elif self.mode == 'slide':
            patch_features = input['feats']
            coordinates = input['coords']
            output = self.slide_model(patch_features, coordinates)[0]
            return output
        else:
            raise ValueError(f"Invalid mode: {self.mode}")
        

class PRISMModel(nn.Module):
    def __init__(self, mode):
        super().__init__()
        self.mode = mode
        if self.mode == 'patch':

            import piano

            self.patch_model = piano.create_model('virchow_v1')
        elif self.mode == 'slide':
            self.slide_model = AutoModel.from_pretrained('paige-ai/Prism', trust_remote_code=True)
        else:
            raise ValueError(f"Invalid mode: {self.mode}")
    
    def forward(self, input):
        if self.mode == 'patch':
            image_tensor = input['feats']
            output = self.patch_model.encode_image(image_tensor)
            return output
        elif self.mode == 'slide':
            patch_features = input['feats']
            result = self.slide_model.slide_representations(patch_features)
            output = result['image_embedding']
            return output
    
        

class TITANModel(nn.Module):
    def __init__(self, mode):
        super().__init__()
        self.mode = mode
        if self.mode == 'patch':

            import piano

            self.patch_model = piano.create_model('conch_v1_5')
        elif self.mode == 'slide':
            self.slide_model = AutoModel.from_pretrained('MahmoodLab/TITAN', trust_remote_code=True)
        else:
            raise ValueError(f"Invalid mode: {self.mode}")
    
    def forward(self, input):
        if self.mode == 'patch':
            image_tensor = input['feats']
            output = self.patch_model.encode_image(image_tensor)
            return output
        elif self.mode == 'slide':
            patch_features = input['feats']
            coordinates = input['coords']
            patch_size_lv0 = 1024
            output = self.slide_model.encode_slide_from_patch_features(patch_features, coordinates, patch_size_lv0)
            return output



def create_slide_pretrained_model(model_name, mode):
    if model_name == 'chief':
        return CHIEFModel(mode)
    elif model_name == 'gigapath':
        return GigaPathModel(mode)
    elif model_name == 'titan':
        return TITANModel(mode)
    elif model_name == 'prism':
        return PRISMModel(mode)
    else:
        raise ValueError(f"Invalid model name: {model_name}")
    

